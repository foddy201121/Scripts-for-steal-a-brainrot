local player = game.Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- GUI
local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 200, 0, 50)
button.Position = UDim2.new(0, 20, 0, 200)
button.Text = "Lagger"
button.TextScaled = true
button.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
button.TextColor3 = Color3.new(1, 1, 1)
button.Parent = gui

-- Tools WITHOUT Quantum
local slapTools = {
	"Blackhole Slap",
	"Slap",
	"Gold Slap",
	"Diamond Slap",
	"Galaxy Slap",
	"Iron Slap",
	"Splatter Slap",
	"Dark Matter Slap",
	"Radioactive Slap",
	"Emerald Slap",
	"Glitched Slap"
}

local quantumName = "Quantum Cloner"
local ran = false

button.MouseButton1Click:Connect(function()
	if ran then return end
	ran = true
	button.Text = "Running..."

	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")

	-- 1️⃣ Equip ALL slaps first
	for _, name in ipairs(slapTools) do
		local tool = backpack:FindFirstChild(name)
		if tool then
			humanoid:EquipTool(tool)
			task.wait(0.05)
		end
	end

	-- 2️⃣ Small delay so server registers equips
	task.wait(0.2)

	-- 3️⃣ Equip Quantum LAST
	local quantum = backpack:FindFirstChild(quantumName)
	if quantum then
		humanoid:EquipTool(quantum)
	end

	-- 4️⃣ Fire UseItem ONCE (this triggers the clone)
	task.wait(0.05)
	pcall(function()
		ReplicatedStorage.Packages.Net["RE/UseItem"]:FireServer()
	end)

	-- Done
	task.wait(0.2)
	button:Destroy()
end)
