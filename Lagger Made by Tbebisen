local player = game.Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- GUI
local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 200, 0, 50)
button.Position = UDim2.new(0, 20, 0, 200)
button.Text = "Lagger"
button.TextScaled = true
button.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
button.TextColor3 = Color3.new(1, 1, 1)
button.Parent = gui

-- Tool list (Ban Hammer removed)
local toolNames = {
	"Blackhole Slap",
	"Slap",
	"Gold Slap",
	"Diamond Slap",
	"Galaxy Slap",
	"Iron Slap",
	"Splatter Slap",
	"Dark Matter Slap",
	"Radioactive Slap",
	"Emerald Slap",
	"Glitched Slap",
	"Quantum Cloner"
}

local ran = false

button.MouseButton1Click:Connect(function()
	if ran then return end
	ran = true

	-- Optional: disable button visually
	button.AutoButtonColor = false
	button.Text = "Running..."
	button.BackgroundTransparency = 0.3

	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")

	-- Equip tools ONCE
	for _, name in ipairs(toolNames) do
		local tool = backpack:FindFirstChild(name) or character:FindFirstChild(name)
		if tool and tool:IsA("Tool") then
			humanoid:EquipTool(tool)
			task.wait()
		end
	end

	-- Fire RemoteEvent ONCE
	pcall(function()
		ReplicatedStorage.Packages.Net["RE/UseItem"]:FireServer()
	end)

	-- Optional: remove button after running
	task.wait(0.2)
	button:Destroy()
end)
