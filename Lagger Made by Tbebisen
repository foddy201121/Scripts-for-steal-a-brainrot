local player = game.Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- GUI
local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 200, 0, 50)
button.Position = UDim2.new(0, 20, 0, 200)
button.Text = "Lagger"
button.TextScaled = true
button.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
button.TextColor3 = Color3.new(1,1,1)
button.Parent = gui

-- Tool names
local toolNames = {
	"Blackhole Slap",
	"Ban Hammer",
	"Slap",
	"Gold Slap",
	"Diamond Slap",
	"Galaxy Slap",
	"Iron Slap",
	"Splatter Slap",
	"Dark Matter Slap",
	"Radioactive Slap",
	"Emerald Slap",
	"Glitched Slap",
	"Quantum Cloner"
}

local used = false

button.MouseButton1Click:Connect(function()
	if used then return end -- prevent running twice
	used = true
	button.Text = "Running..."

	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")

	-- Equip tools ONCE
	for _, name in ipairs(toolNames) do
		local tool = backpack:FindFirstChild(name) or character:FindFirstChild(name)
		if tool and tool:IsA("Tool") then
			humanoid:EquipTool(tool)
			task.wait() -- small yield so Roblox registers equips
		end
	end

	-- Run the code ONCE
	pcall(function()
		ReplicatedStorage.Packages.Net["RE/UseItem"]:FireServer()
	end)

	button.Text = "Done"
end)
