local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- 🔴 PUT YOUR RAW GITHUB URL HERE
local WHITELIST_URL = "https://raw.githubusercontent.com/USERNAME/REPO/main/access.json"

local function parseDate(dateStr)
    local y, m, d = dateStr:match("(%d+)%-(%d+)%-(%d+)")
    return os.time({
        year = tonumber(y),
        month = tonumber(m),
        day = tonumber(d),
        hour = 23,
        min = 59,
        sec = 59
    })
end

local function checkAccess()
    local success, response = pcall(function()
        return HttpService:GetAsync(WHITELIST_URL)
    end)

    if not success then
        return false, "License server unreachable"
    end

    local data = HttpService:JSONDecode(response)
    local user = data.users[tostring(player.UserId)]

    if not user or not user.expires then
        return false, "Not licensed"
    end

    local expireTime = parseDate(user.expires)

    if os.time() > expireTime then
        return false, "Expired"
    end

    return true
end

local allowed, reason = checkAccess()

if not allowed then
    local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
    gui.Name = "LicenseExpiredGUI"

    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(0, 320, 0, 120)
    frame.Position = UDim2.new(0.5, -160, 0.5, -60)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    frame.BorderSizePixel = 0

    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 12)

    local text = Instance.new("TextLabel", frame)
    text.Size = UDim2.new(1, -20, 1, -20)
    text.Position = UDim2.new(0, 10, 0, 10)
    text.BackgroundTransparency = 1
    text.TextWrapped = true
    text.TextColor3 = Color3.fromRGB(255, 80, 80)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 14
    text.Text = "Your access has expired.\nPlease purchase to continue."

    return
end

