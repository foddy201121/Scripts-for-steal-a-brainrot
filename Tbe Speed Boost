-- ================= SYNC FUNCTIONS =================

local function updateUIFromSpeed()
    speedLabel.Text = "Speed: "..baseSpeed
    inputBox.Text = tostring(baseSpeed)
end

local function setSpeed(value)
    baseSpeed = math.clamp(math.floor(value), MIN_SPEED, MAX_SPEED)
    updateUIFromSpeed()
end

updateUIFromSpeed()

inputBox.FocusLost:Connect(function()
    local num = tonumber(inputBox.Text)
    if num then
        setSpeed(num)
    end
end)
