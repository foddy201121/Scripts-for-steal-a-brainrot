-- LocalScript

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- Default settings
local speedBoost = 16
local customGravity = Workspace.Gravity -- default is 196.2

-- Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Parent = player:WaitForChild("PlayerGui")

-- Create Frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 150)
frame.Position = UDim2.new(0.5, -150, 0.5, -75)
frame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
frame.Parent = screenGui

-- Create SpeedBoost TextBox
local speedBox = Instance.new("TextBox")
speedBox.Size = UDim2.new(0, 200, 0, 50)
speedBox.Position = UDim2.new(0, 50, 0, 20)
speedBox.PlaceholderText = "Enter Speed Boost"
speedBox.Text = tostring(speedBoost)
speedBox.ClearTextOnFocus = false
speedBox.Parent = frame

-- Create Gravity TextBox
local gravityBox = Instance.new("TextBox")
gravityBox.Size = UDim2.new(0, 200, 0, 50)
gravityBox.Position = UDim2.new(0, 50, 0, 80)
gravityBox.PlaceholderText = "Enter Gravity"
gravityBox.Text = tostring(customGravity)
gravityBox.ClearTextOnFocus = false
gravityBox.Parent = frame

-- Create StealBoost Button
local boostButton = Instance.new("TextButton")
boostButton.Size = UDim2.new(0, 200, 0, 40)
boostButton.Position = UDim2.new(0, 50, 0, 130)
boostButton.Text = "StealBoost"
boostButton.BackgroundColor3 = Color3.fromRGB(100, 100, 255)
boostButton.Parent = frame

-- Function to apply speed boost and gravity
local function applyBoost()
    local inputSpeed = tonumber(speedBox.Text)
    local inputGravity = tonumber(gravityBox.Text)

    if inputSpeed then
        humanoid.WalkSpeed = inputSpeed
    end

    if inputGravity then
        Workspace.Gravity = inputGravity
    end
end

-- Connect button click
boostButton.MouseButton1Click:Connect(applyBoost)

-- Optional: continuously apply in case of physics reset
RunService.RenderStepped:Connect(function()
    humanoid.WalkSpeed = tonumber(speedBox.Text) or 16
    Workspace.Gravity = tonumber(gravityBox.Text) or 196.2
end)
